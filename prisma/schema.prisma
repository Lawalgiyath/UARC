generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubmissionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

/// Payment by Remita is not instant, so a registration passes through a stage
/// the old card-only flow had no name for: the delegate has paid at the bank
/// and sent the receipt, but nobody has checked it yet.
enum RegistrationStatus {
  /// Registered, nothing paid yet.
  PENDING
  /// RRR and receipt submitted, waiting on the Secretariat.
  DECLARED
  /// Receipt checked and accepted. Only PAID counts as registered.
  PAID
  /// Receipt checked and refused, with a reason.
  REJECTED
  /// Card payment failed. Only reachable on the Paystack route.
  FAILED
}

/// How a payment was, or will be, made.
enum PaymentMethod {
  /// The university's Remita portal, paid at a bank, receipt uploaded here.
  REMITA
  /// Card or transfer through Paystack, if credentials are configured.
  PAYSTACK
}

/// Student rates are only released once the claim has been checked.
enum VerificationStatus {
  NOT_REQUIRED
  PENDING
  VERIFIED
  REJECTED
}

/// Sponsors and exhibitors follow the same Remita route as delegates, with one
/// extra state at the end: PAID means the money is in, CONFIRMED means the
/// Secretariat has also agreed the logo, the stand or the programme entry.
enum PartnerStatus {
  PENDING
  AWAITING_PAYMENT
  DECLARED
  PAID
  CONFIRMED
  REJECTED
  FAILED
  CANCELLED
}

enum CertificateKind {
  ATTENDANCE
  PRESENTATION
  POSTER
  SESSION_CHAIR
  REVIEWER
}

model Submission {
  id                 String           @id @default(cuid())
  reference          String           @unique
  authorName         String
  email              String
  phone              String
  institution        String
  track              String
  format             String
  title              String
  abstractText       String
  manuscriptUrl      String?
  manuscriptPublicId String?
  status             SubmissionStatus @default(PENDING)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  certificates Certificate[]

  @@index([email])
  @@index([status])
}

model Registration {
  id          String             @id @default(cuid())
  reference   String             @unique
  fullName    String
  email       String
  phone       String
  institution String
  category    String
  amount      Int
  currency    String
  paystackRef String?            @unique
  status      RegistrationStatus @default(PENDING)

  /// Remita unless Paystack credentials are configured and the delegate chose
  /// a card. Recorded per registration, because the two coexist once card
  /// payment is switched on.
  paymentMethod    PaymentMethod @default(REMITA)
  /// The 12 digit Remita Retrieval Reference, stored as 1234-5678-9012.
  rrr              String?
  /// The uploaded bank or Remita receipt. Held in Cloudinary, not here.
  receiptUrl       String?
  receiptPublicId  String?
  /// When the delegate said they had paid.
  declaredAt       DateTime?
  /// What the payer says they paid, in whole units of the currency. Typed in
  /// rather than read off the receipt, so it is a claim to be checked, not a
  /// fact. Recording it as a number is what makes any check possible at all.
  declaredAmount   Int?
  /// The date printed on the receipt, as the payer read it.
  paidOn           DateTime?
  /// Bank branch or channel the payment went through, in the payer's words.
  paidVia          String?
  /// Machine codes from the automatic checks, e.g. AMOUNT_SHORT. Empty when
  /// nothing was found. See lib/paymentChecks.ts.
  checkFlags       String[]      @default([])
  /// CLEAR or REVIEW, decided by those checks the moment a payment is declared.
  checkVerdict     String?
  /// When the Secretariat accepted or refused the receipt.
  paymentCheckedAt DateTime?
  /// Why a receipt was refused, shown to the delegate.
  paymentNote      String?

  /// Country of residence, so international delegates can be supported with
  /// visa letters and dial-in guidance.
  country String?

  /// Delegates choose whether their name appears on the public list. Default
  /// off: publishing an attendee list without consent is not ours to do.
  listPublicly Boolean @default(false)

  /// Student verification. `studentIdNumber` is a matriculation or student
  /// number; `studentInstitutionEmail` is the institutional address the claim
  /// was made against. Both are only collected for student categories.
  verification            VerificationStatus @default(NOT_REQUIRED)
  studentIdNumber         String?
  studentInstitutionEmail String?
  verifiedAt              DateTime?
  verificationNote        String?

  /// Set at the registration desk, and the trigger for issuing a certificate.
  attended   Boolean   @default(false)
  attendedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  certificates Certificate[]

  @@index([email])
  @@index([status])
  @@index([verification])
  @@index([listPublicly, status])
  @@index([rrr])
}

model Sponsor {
  id           String        @id @default(cuid())
  reference    String        @unique
  organisation String
  contactName  String
  email        String
  phone        String
  tier         String
  amount       Int
  currency     String
  paystackRef  String?       @unique
  status       PartnerStatus @default(PENDING)

  paymentMethod    PaymentMethod @default(REMITA)
  rrr              String?
  receiptUrl       String?
  receiptPublicId  String?
  declaredAt       DateTime?
  /// What the payer says they paid, in whole units of the currency. Typed in
  /// rather than read off the receipt, so it is a claim to be checked, not a
  /// fact. Recording it as a number is what makes any check possible at all.
  declaredAmount   Int?
  /// The date printed on the receipt, as the payer read it.
  paidOn           DateTime?
  /// Bank branch or channel the payment went through, in the payer's words.
  paidVia          String?
  /// Machine codes from the automatic checks, e.g. AMOUNT_SHORT. Empty when
  /// nothing was found. See lib/paymentChecks.ts.
  checkFlags       String[]      @default([])
  /// CLEAR or REVIEW, decided by those checks the moment a payment is declared.
  checkVerdict     String?
  paymentCheckedAt DateTime?
  paymentNote      String?

  /// Shown on the sponsor wall once the sponsorship is confirmed and the
  /// Secretariat has ticked `displayOnSite`.
  websiteUrl    String?
  logoUrl       String?
  logoPublicId  String?
  displayOnSite Boolean @default(false)
  message       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([displayOnSite, status])
}

model Exhibitor {
  id           String        @id @default(cuid())
  reference    String        @unique
  organisation String
  contactName  String
  email        String
  phone        String
  packageKey   String
  amount       Int
  currency     String
  paystackRef  String?       @unique
  status       PartnerStatus @default(PENDING)

  paymentMethod    PaymentMethod @default(REMITA)
  rrr              String?
  receiptUrl       String?
  receiptPublicId  String?
  declaredAt       DateTime?
  /// What the payer says they paid, in whole units of the currency. Typed in
  /// rather than read off the receipt, so it is a claim to be checked, not a
  /// fact. Recording it as a number is what makes any check possible at all.
  declaredAmount   Int?
  /// The date printed on the receipt, as the payer read it.
  paidOn           DateTime?
  /// Bank branch or channel the payment went through, in the payer's words.
  paidVia          String?
  /// Machine codes from the automatic checks, e.g. AMOUNT_SHORT. Empty when
  /// nothing was found. See lib/paymentChecks.ts.
  checkFlags       String[]      @default([])
  /// CLEAR or REVIEW, decided by those checks the moment a payment is declared.
  checkVerdict     String?
  paymentCheckedAt DateTime?
  paymentNote      String?

  description   String?
  websiteUrl    String?
  logoUrl       String?
  logoPublicId  String?
  standNumber   String?
  displayOnSite Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([displayOnSite, status])
}

/// Issued automatically once attendance is recorded. `code` is the public
/// verification code printed on the certificate; anyone can check it at
/// /verify without being able to enumerate the register, because the code is
/// long and random and lookups are rate limited.
model Certificate {
  id            String          @id @default(cuid())
  code          String          @unique
  kind          CertificateKind
  recipientName String
  institution   String?
  /// Paper title, for presentation and poster certificates.
  paperTitle    String?
  track         String?
  issuedAt      DateTime        @default(now())
  revokedAt     DateTime?
  revokedReason String?

  registrationId String?
  registration   Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  submissionId   String?
  submission     Submission?   @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  @@index([registrationId])
  @@index([submissionId])
  @@index([kind])
}

/// Fixed window counters for rate limiting. Kept in the database rather than
/// in process memory so the limit still holds when the app runs as more than
/// one serverless instance, which is exactly when brute force matters.
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model Setting {
  key   String @id
  value String
}
